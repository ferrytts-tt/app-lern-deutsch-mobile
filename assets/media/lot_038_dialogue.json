      "debut_ms": 4992,
      "fin_ms": 7416,
      "phrase_id": "phrase_373"
    },
    {
      "locuteur": "Katja",
      "de": "Ich bin durchgerasselt.",
      "ar": "رسبت.",
      "fr": "J'ai raté l'examen.",
      "debut_ms": 7416,
      "fin_ms": 9672,
      "phrase_id": "phrase_374"
    },
    {
      "locuteur": "Conrad",
      "de": "Ich hab's bestanden!",
      "ar": "نجحت!",
      "fr": "Je l'ai réussi !",
      "debut_ms": 9672,
      "fin_ms": 11880,
      "phrase_id": "phrase_375"
    },
    {
      "locuteur": "Katja",
      "de": "Wann ist Abgabe?",
      "ar": "متى موعد التسليم؟",
      "fr": "C'est pour quand le rendu ?",
      "debut_ms": 11880,
      "fin_ms": 14016,
      "phrase_id": "phrase_376"
    },
    {
      "locuteur": "Conrad",
      "de": "Kannst du mir mal deine Mitschrift schicken?",
      "ar": "هل ترسل لي ملاحظاتك؟",
      "fr": "Tu peux m'envoyer tes notes ?",
      "debut_ms": 14016,
      "fin_ms": 17088,
      "phrase_id": "phrase_377"
    },
    {
      "locuteur": "Katja",
      "de": "Ich hab die Vorlesung geschwänzt.",
