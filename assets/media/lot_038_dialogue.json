      "fr": "Demain j'ai un contrôle.",
      "debut_ms": 0,
      "fin_ms": 2616,
      "phrase_id": "phrase_371"
    },
    {
      "locuteur": "Katja",
      "de": "Ich hab gar nicht gelernt.",
      "ar": "لم أذاكر إطلاقاً.",
      "fr": "Je n'ai pas du tout révisé.",
