      "fr": "Baisse la musique !",
      "debut_ms": 0,
      "fin_ms": 2496,
      "phrase_id": "phrase_331"
    },
    {
      "locuteur": "Katja",
      "de": "Hat jemand mein Handy gesehen?",
      "ar": "هل رأى أحد هاتفي؟",
      "fr": "Quelqu'un a vu mon portable ?",
      "debut_ms": 2496,
      "fin_ms": 5352,
      "phrase_id": "phrase_332"
    },
    {
      "locuteur": "Conrad",
      "de": "Ich geh jetzt pennen.",
      "ar": "سأذهب لأنام.",
      "fr": "Je vais pioncer.",
      "debut_ms": 5352,
      "fin_ms": 7440,
      "phrase_id": "phrase_333"
    },
    {
      "locuteur": "Katja",
      "de": "Schlaf schön!",
      "ar": "نم جيداً!",
      "fr": "Dors bien !",
      "debut_ms": 7440,
      "fin_ms": 9312,
      "phrase_id": "phrase_334"
    },
    {
      "locuteur": "Conrad",
      "de": "Wann kommst du heim?",
      "ar": "متى ستعود إلى البيت؟",
      "fr": "Tu rentres quand ?",
      "debut_ms": 9312,
      "fin_ms": 11448,
      "phrase_id": "phrase_335"
    },
    {
      "locuteur": "Katja",
      "de": "Fahr vorsichtig, ja?",
