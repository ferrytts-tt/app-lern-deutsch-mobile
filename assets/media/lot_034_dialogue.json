      "fr": "Conduis prudemment !",
      "debut_ms": 11448,
      "fin_ms": 13944,
      "phrase_id": "phrase_336"
    },
    {
      "locuteur": "Conrad",
      "de": "Hast du schon was gegessen?",
      "ar": "هل أكلت شيئاً؟",
      "fr": "Tu as déjà mangé quelque chose ?",
      "debut_ms": 13944,
      "fin_ms": 16368,
      "phrase_id": "phrase_337"
    },
    {
      "locuteur": "Katja",
      "de": "Wir fahren zu Oma und Opa.",
      "ar": "سنذهب إلى جدتي وجدي.",
      "fr": "On va chez mamie et papi.",
      "debut_ms": 16368,
      "fin_ms": 19248,
      "phrase_id": "phrase_338"
    },
    {
      "locuteur": "Conrad",
      "de": "Mein kleiner Bruder nervt voll.",
      "ar": "أخي الصغير يزعجني كثيراً.",
      "fr": "Mon petit frère est insupportable.",
      "debut_ms": 19248,
      "fin_ms": 22032,
      "phrase_id": "phrase_339"
    },
    {
      "locuteur": "Katja",
      "de": "Hört auf zu streiten!",
      "ar": "كفّوا عن الشجار!",
      "fr": "Arrêtez de vous disputer !",
