{
  "lot_id": 8,
  "type": "dialogue",
  "title_de": "Schlechte Verbindung",
  "title_ar": "اتصال هاتفي مشوش",
  "title_fr": "Mauvaise réception au téléphone",
  "lignes": [
    {
      "locuteur": "Conrad",
      "de": "Ich versteh dich ganz schlecht, die Leitung ist mies.",
      "ar": "لا أسمعك جيداً، الخط سيئ",
      "fr": "Je te capte très mal, la ligne est pourrie.",
      "debut_ms": 0,
      "fin_ms": 3768,
      "phrase_id": "phrase_071"
    },
    {
      "locuteur": "Katja",
      "de": "Ich ruf dich gleich zurück.",
      "ar": "سأتصل بك بعد قليل",
      "fr": "Je te rappelle tout de suite.",
      "debut_ms": 3768,
      "fin_ms": 6072,
      "phrase_id": "phrase_072"
    },
    {
      "locuteur": "Conrad",
      "de": "Ich hab dir geschrieben.",
      "ar": "أرسلت لك رسالة",
      "fr": "Je t'ai envoyé un message.",
      "debut_ms": 6072,
      "fin_ms": 8160,
      "phrase_id": "phrase_073"
    },
    {
      "locuteur": "Katja",
      "de": "Mein Akku is' gleich leer.",
      "ar": "بطاريتي ستنفد قريباً",
      "fr": "J'ai presque plus de batterie.",
      "debut_ms": 8160,
      "fin_ms": 10848,
      "phrase_id": "phrase_074"
    },
    {
      "locuteur": "Conrad",
      "de": "Du hast mich angerufen? Hab ich nicht gehört.",
      "ar": "اتصلت بي؟ ما سمعت",
      "fr": "Tu m'as appelé ? J'ai pas entendu.",
      "debut_ms": 10848,
      "fin_ms": 15168,
      "phrase_id": "phrase_075"
    },
    {
      "locuteur": "Katja",
      "de": "Schick mir mal den Standort.",
      "ar": "أرسل لي الموقع",
      "fr": "Envoie-moi ta position.",
      "debut_ms": 15168,
      "fin_ms": 17712,
      "phrase_id": "phrase_076"
    },
    {
      "locuteur": "Conrad",
      "de": "Ich schreib dir gleich.",
      "ar": "سأكتب لك حالاً",
      "fr": "Je t'écris dans un instant.",
      "debut_ms": 17712,
      "fin_ms": 19800,
      "phrase_id": "phrase_077"
    },
    {
      "locuteur": "Katja",
      "de": "Dich erreicht man ja nie!",
      "ar": "ما أحد يقدر يوصلك أبداً!",
      "fr": "On n'arrive jamais à te joindre !",
      "debut_ms": 19800,
      "fin_ms": 22080,
      "phrase_id": "phrase_078"
    },
    {
      "locuteur": "Conrad",
      "de": "Ich hatte kein Netz.",
      "ar": "ما كان عندي شبكة",
      "fr": "J'avais pas de réseau.",
      "debut_ms": 22080,
      "fin_ms": 24096,
      "phrase_id": "phrase_079"
    },
    {
      "locuteur": "Katja",
      "de": "Check mal kurz meine Nachricht.",
      "ar": "اطلع على رسالتي",
      "fr": "Regarde vite mon message.",
      "debut_ms": 24096,
      "fin_ms": 26928,
      "phrase_id": "phrase_080"
    }
  ]
}