      "debut_ms": 7080,
      "fin_ms": 9336,
      "phrase_id": "phrase_454"
    },
    {
      "locuteur": "Conrad",
      "de": "Ich hab meinen Anschlussflug verpasst.",
      "ar": "فاتتني رحلة الربط.",
      "fr": "J'ai raté ma correspondance.",
      "debut_ms": 9336,
      "fin_ms": 12168,
      "phrase_id": "phrase_455"
    },
    {
      "locuteur": "Katja",
      "de": "Zum Hauptbahnhof, bitte.",
      "ar": "إلى المحطة الرئيسية من فضلك.",
      "fr": "À la gare centrale, s'il vous plaît.",
      "debut_ms": 12168,
      "fin_ms": 14952,
      "phrase_id": "phrase_456"
    },
    {
      "locuteur": "Conrad",
      "de": "Zum Flughafen, Terminal 2.",
      "ar": "إلى المطار، المبنى 2 من فضلك.",
      "fr": "À l'aéroport, terminal 2, s'il vous plaît.",
      "debut_ms": 14952,
      "fin_ms": 18096,
      "phrase_id": "phrase_457"
    },
    {
      "locuteur": "Katja",
      "de": "Was kostet das ungefähr?",
      "ar": "كم تكلفة الرحلة تقريباً؟",
      "fr": "Ça coûte combien environ ?",
      "debut_ms": 18096,
      "fin_ms": 20712,
      "phrase_id": "phrase_458"
    },
    {
      "locuteur": "Conrad",
      "de": "Wie lange brauchen wir?",
      "ar": "كم تستغرق الرحلة؟",
      "fr": "Combien de temps dure le trajet ?",
