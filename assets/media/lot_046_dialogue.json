      "fin_ms": 2184,
      "phrase_id": "phrase_451"
    },
    {
      "locuteur": "Katja",
      "de": "Mein Koffer ist nicht da.",
      "ar": "لم تصل حقيبتي.",
      "fr": "Ma valise n'est pas arrivée.",
      "debut_ms": 2184,
      "fin_ms": 4560,
      "phrase_id": "phrase_452"
    },
    {
      "locuteur": "Conrad",
      "de": "Mein Flug hat Verspätung.",
      "ar": "رحلتي متأخرة.",
      "fr": "Mon vol a du retard.",
